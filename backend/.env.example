# Ortam değişkeni şablonu: bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env repoya commit edilmez; bu dosyaya gerçek anahtar veya parola yazılmaz.
# Not: Şu anda yalnızca DATABASE_URL okunuyor; diğerleri ilgili geliştirme aşamalarında kullanılmaya başlanacak.

# Gemini API anahtarı
GEMINI_API_KEY=

# Sınıflandırma modeli (zorunlu, kodda varsayılan yok)
GEMINI_MODEL=gemini-3.5-flash-lite

# PostgreSQL bağlantı adresi (zorunlu; psycopg 3 sürücüsü).
# Değer, repo kökündeki docker-compose.yml ile çalışan yerel geliştirme veritabanına aittir (host portu 5433).
# "localhost" yerine 127.0.0.1: port yalnızca IPv4 localhost'a açık; "localhost" önce IPv6 (::1) denendiğinde bağlantı asılı kalıyor.
# Bu kullanıcı/parola yalnızca yerel geliştirme içindir.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/dosya_sistemi

# Yüklenen orijinal dosyaların klasörü (backend/ klasörüne göre)
STORAGE_DIR=storage

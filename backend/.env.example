# Ortam değişkeni şablonu: bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env repoya commit edilmez; bu dosyaya gerçek anahtar veya parola yazılmaz.
# İlk üç değişken zorunludur; TESSDATA_PREFIX opsiyoneldir.
# Gemini değişkenleri Gemini istemcisi (app/llm/gemini_client.py) yüklenirken kontrol edilir.

# Gemini API anahtarı (zorunlu). Gerçek anahtar yalnızca .env dosyasına yazılır.
GEMINI_API_KEY=

# Sınıflandırma ve OCR transkripsiyon modeli (zorunlu, kodda varsayılan yok; D-047)
GEMINI_MODEL=gemini-3.5-flash-lite

# PostgreSQL bağlantı adresi (zorunlu; psycopg 3 sürücüsü).
# Değer, repo kökündeki docker-compose.yml ile çalışan yerel geliştirme veritabanına aittir (host portu 5434, D-051).
# "localhost" yerine 127.0.0.1: port yalnızca IPv4 localhost'a açık; "localhost" önce IPv6 (::1) denendiğinde bağlantı asılı kalıyor.
# Bu kullanıcı/parola yalnızca yerel geliştirme içindir.
# connect_timeout=10: bağlantı kurma en fazla 10 sn bekler (D-041); sorgu süresini sınırlamaz.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5434/dosya_sistemi?connect_timeout=10

# Tesseract dil dosyalarının (tessdata) klasörü — OPSİYONEL.
# Gemini transkripsiyonu başarısız ya da yetersiz olduğunda çalışan acil durum OCR yedeği için kullanılır (D-042, D-047).
# Tanımlı değilse yedek OCR atlanır; Gemini transkripsiyonu da başarısız olan belge "yeterli metin yok" sayılır.
# Uygulama yine de başlar.
# Tesseract kurulumunda tur dil paketi bulunmalıdır. Kurulum yolu makineye göre değişir, örnekler:
#   Windows : C:\Program Files\Tesseract-OCR\tessdata
#   Linux   : /usr/share/tesseract-ocr/5/tessdata
#   macOS   : /opt/homebrew/share/tessdata
TESSDATA_PREFIX=

# OCR'ın iki yolunu (Gemini transkripsiyonu ve Tesseract yedeği) açar/kapatır — OPSİYONEL, varsayılan true (D-055).
# false iken taranmış PDF ve görüntü OCR'a girmeden "OCR kapalı" mesajıyla 422 alır. Yalnız true veya false.
OCR_ENABLED=true

# Kayıtlar'dan kalıcı silmeyi açar/kapatır — OPSİYONEL, varsayılan true (D-057).
# false iken DELETE /api/documents/{id} hiçbir şeye dokunmadan 403 döner; Kaldır etkilenmez. Yalnız true veya false.
PERMANENT_DELETE_ENABLED=true

# Ortam değişkeni şablonu: bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env repoya commit edilmez; bu dosyaya gerçek anahtar veya parola yazılmaz.
# İlk üç değişken zorunludur; TESSDATA_PREFIX opsiyoneldir.
# Gemini değişkenleri Gemini istemcisi (app/llm/gemini_client.py) yüklenirken kontrol edilir.

# Gemini API anahtarı (zorunlu). Gerçek anahtar yalnızca .env dosyasına yazılır.
GEMINI_API_KEY=

# Sınıflandırma modeli (zorunlu, kodda varsayılan yok)
GEMINI_MODEL=gemini-3.5-flash-lite

# PostgreSQL bağlantı adresi (zorunlu; psycopg 3 sürücüsü).
# Değer, repo kökündeki docker-compose.yml ile çalışan yerel geliştirme veritabanına aittir (host portu 5433).
# "localhost" yerine 127.0.0.1: port yalnızca IPv4 localhost'a açık; "localhost" önce IPv6 (::1) denendiğinde bağlantı asılı kalıyor.
# Bu kullanıcı/parola yalnızca yerel geliştirme içindir.
# connect_timeout=10: bağlantı kurma en fazla 10 sn bekler (D-041); sorgu süresini sınırlamaz.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/dosya_sistemi?connect_timeout=10

# Tesseract dil dosyalarının (tessdata) klasörü — OPSİYONEL.
# Taranmış PDF'lerde OCR fallback'i ve JPG/JPEG/PNG belgelerinde doğrudan OCR için kullanılır (D-001, D-003, D-042).
# Tanımlı değilse OCR atlanır ve bu belgeler V1'deki gibi "yeterli metin yok" sayılır; uygulama yine de başlar.
# Tesseract kurulumunda tur dil paketi bulunmalıdır. Kurulum yolu makineye göre değişir, örnekler:
#   Windows : C:\Program Files\Tesseract-OCR\tessdata
#   Linux   : /usr/share/tesseract-ocr/5/tessdata
#   macOS   : /opt/homebrew/share/tessdata
TESSDATA_PREFIX=

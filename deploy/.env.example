# Production Compose ortam değişkenleri (deploy/docker-compose.prod.yml).
# Bu dosyayı deploy/.env olarak kopyalayıp değerleri doldurun. deploy/.env repoya commit edilmez;
# bu dosyaya gerçek parola veya API anahtarı yazılmaz. Hepsi zorunludur: eksikse Compose açık hatayla durur.
#
# Parolalar DATABASE_URL içine girer; URL'de özel anlamı olan karakter içermemeleri için hex üretin:
#   openssl rand -hex 32
# Parolalar yalnız boş veritabanı volume'üyle ilk başlatmada uygulanır (deploy/postgres/initdb/10-app-roles.sh).
# Sonradan değiştirmek için README → "Production Docker" bölümündeki ALTER ROLE adımına bakın.

# PostgreSQL superuser (dosya_admin) parolası: yalnız veritabanı bakımı içindir, uygulama kullanmaz.
POSTGRES_PASSWORD=

# Migration rolü (dosya_migrator, veritabanı sahibi): yalnız "migrate" servisi kullanır.
DOSYA_MIGRATOR_PASSWORD=

# Uygulama rolü (dosya_app): yalnız tablo verisi okur/yazar, şema değiştiremez.
DOSYA_APP_PASSWORD=

# Gemini sınıflandırması (D-007, D-047). OCR bu yayında kapalıdır (D-055); anahtar yalnız sınıflandırma için kullanılır.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
